theory DHIT_Coherence_From_Local
  imports DHIT_Local_Naturality DHIT_Endpoint_Serialization
begin

section \<open>Elementary naturality suffices for the complete tuple presentation\<close>

lemma path_image_lift:
  "path_image (\<lambda>e. lift_path C (L e)) p = lift_path C (path_image L p)"
proof (induct p)
  case Nil
  then show ?case by simp
next
  case (Cons d p)
  then show ?case by (cases d) simp_all
qed

context locally_natural_signature_family
begin

sublocale motions: endpoint_functor S h P edges src dst
  by unfold_locales (auto intro: source_tree target_tree)

lemma serialized_endpoint_transport:
  assumes endpoint: "wf_endpt S h ss e (Hit h)"
    and M: "paths.argument_motion ss xs ps ys"
    and C: "valid_shell S h P C"
    and A: "a \<in> F (plug_term h C (instE h xs e))"
  shows "fibers.transport
    (path_image (\<lambda>b. lift_path C (endpoint_motion h
      (argument_source h src b) (argument_source h dst b) (paths.elementary_motion b) e))
      (serialize_arguments [] xs ys ps)) a =
    fibers.transport (lift_path C (endpoint_motion h xs ys ps e)) a"
proof -
  note Q = motions.endpoint_motion_serialization[OF endpoint M external_points]
  note L = contexts.presented_interchange_lifting[OF Q C]
  show ?thesis
    using fibers.all_fiber_interchange_descent[OF L A]
    by (simp only: path_image_lift)
qed

lemma elementary_implies_tuple_naturality:
  assumes K: "k < length (lcons (S h))"
    and M: "paths.argument_motion (lcons (S h) ! k) xs ps ys"
    and C: "valid_shell S h P C"
    and A: "a \<in> F (plug_term h C (lhsOf S h k xs))"
  shows "fibers.transport (lift_path C (endpoint_motion h xs ys ps (fst (lends (S h) ! k)) @
      [Pos (Generator (k,ys))])) a =
    fibers.transport (lift_path C ([Pos (Generator (k,xs))] @
      endpoint_motion h xs ys ps (snd (lends (S h) ! k)))) a"
proof -
  have L: "fibers.transport (path_image (elementary_left k C)
      (serialize_arguments [] xs ys ps)) a =
    fibers.transport (lift_path C (endpoint_motion h xs ys ps (fst (lends (S h) ! k)))) a"
  proof -
    have E: "elementary_left k C = (\<lambda>b. lift_path C (endpoint_motion h
      (argument_source h src b) (argument_source h dst b) (paths.elementary_motion b)
      (fst (lends (S h) ! k))))"
      by (rule ext) (simp only: elementary_left_def)
    have T: "a \<in> F (plug_term h C (instE h xs (fst (lends (S h) ! k))))"
      using A by (simp only: lhsOf_def)
    show ?thesis
      using serialized_endpoint_transport[OF wf_hsig_lhs[OF signature K] M C T]
      by (simp only: E)
  qed
  have T: "fibers.transport (generator_component k C xs) a \<in>
    F (plug_term h C (rhsOf S h k xs))"
    by (rule fibers.transport_type[OF generator_component_typed[OF K C
      paths.argument_motion_carriers(1)[OF M]] A])
  have R: "fibers.transport (path_image (elementary_right k C)
      (serialize_arguments [] xs ys ps)) (fibers.transport (generator_component k C xs) a) =
    fibers.transport (lift_path C (endpoint_motion h xs ys ps (snd (lends (S h) ! k))))
      (fibers.transport (generator_component k C xs) a)"
  proof -
    have E: "elementary_right k C = (\<lambda>b. lift_path C (endpoint_motion h
      (argument_source h src b) (argument_source h dst b) (paths.elementary_motion b)
      (snd (lends (S h) ! k))))"
      by (rule ext) (simp only: elementary_right_def)
    have T': "fibers.transport (generator_component k C xs) a \<in>
      F (plug_term h C (instE h xs (snd (lends (S h) ! k))))"
      using T by (simp only: rhsOf_def)
    show ?thesis
      using serialized_endpoint_transport[OF wf_hsig_rhs[OF signature K] M C T']
      by (simp only: E)
  qed
  have N: "fibers.transport (generator_component k C ys)
      (fibers.transport (lift_path C (endpoint_motion h xs ys ps (fst (lends (S h) ! k)))) a) =
    fibers.transport (lift_path C (endpoint_motion h xs ys ps (snd (lends (S h) ! k))))
      (fibers.transport (generator_component k C xs) a)"
    using serialized_argument_naturality[OF K C M A] by (simp only: L R)
  show ?thesis using N
    by (simp only: generator_component_def lift_path_append fibers.transport_append)
qed

sublocale coherent: coherent_signature_family S h P F up down
  by unfold_locales
    (auto intro: signature external_points source_tree target_tree
      fibers.up_type fibers.down_type fibers.down_up fibers.up_down
      fibers.first_slot_independent fibers.second_slot_independent fibers.slot_actions_commute
      elementary_implies_tuple_naturality[simplified])

text \<open>The section remains the recursive fold generated by the supplied
point methods. Its descent to the combined coherence quotient requires the
uniform contextual displayed-algebra laws, not a pre-existing global section.\<close>

lemma constructed_coherent_elimination:
  assumes algebra: "contextual_parameter_algebra S h P F M edges src dst up down"
    and C: "C \<in> coherent.quotient.quotient_hom x y"
    and T: "parameter_tree S h P x"
  shows "coherent.quotient.quotient_transport x y C (parameter_fold S h M x) =
      parameter_fold S h M y \<and> parameter_fold S h M y \<in> F y"
proof -
  interpret A: contextual_parameter_algebra S h P F M edges src dst up down
    by (rule algebra)
  show ?thesis
    by (rule A.constructed_section_quotient_descent[OF
      coherent.quotient.quotient_family_axioms C T])
qed

end

context coherent_signature_family
begin

lemma tuple_implies_elementary_naturality:
  assumes K: "k < length (lcons (S h))" and C: "valid_shell S h P C"
    and E: "e \<in> paths.argument_edges (lcons (S h) ! k)"
    and A: "a \<in> F (plug_term h C (lhsOf S h k (argument_source h src e)))"
  shows "fibers.transport (generator_component k C (argument_source h dst e))
      (fibers.transport (elementary_left k C e) a) =
    fibers.transport (elementary_right k C e)
      (fibers.transport (generator_component k C (argument_source h src e)) a)"
  using naturality_law[OF K paths.elementary_motion_typed[OF E] C A]
  by (simp only: generator_component_def elementary_left_def elementary_right_def
    lift_path_append fibers.transport_append)

lemma local_naturality_model:
  "locally_natural_signature_family S h P F up down"
  by unfold_locales
    (auto intro: signature external_points source_tree target_tree
      fibers.up_type fibers.down_type fibers.down_up fibers.up_down
      fibers.first_slot_independent fibers.second_slot_independent fibers.slot_actions_commute
      tuple_implies_elementary_naturality)

end

text \<open>Both sides retain the same sufficient all-fiber interchange laws.
Within that interface, positive single-recursive-slot naturality is equivalent
to compatibility with all tuple naturality cells. Elementary edges may already
lie inside recursive constructor contexts; no reduction to bare path generators
alone is claimed.\<close>

lemma local_global_signature_coherence:
  "locally_natural_signature_family S h P F up down \<longleftrightarrow>
    coherent_signature_family S h P F up down"
proof
  assume H: "locally_natural_signature_family S h P F up down"
  interpret L: locally_natural_signature_family S h P F up down by (rule H)
  show "coherent_signature_family S h P F up down" by (rule L.coherent.coherent_signature_family_axioms)
next
  assume H: "coherent_signature_family S h P F up down"
  interpret G: coherent_signature_family S h P F up down by (rule H)
  show "locally_natural_signature_family S h P F up down" by (rule G.local_naturality_model)
qed

end
