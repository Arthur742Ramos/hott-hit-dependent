theory DHIT_Paths
  imports Main
begin

section \<open>Typed paths in a graph\<close>

datatype 'e dart = Pos 'e | Neg 'e

fun inverse :: "'e dart \<Rightarrow> 'e dart" where
  "inverse (Pos e) = Neg e"
| "inverse (Neg e) = Pos e"

lemma inverse_inverse [simp]: "inverse (inverse a) = a"
  by (cases a) simp_all

fun source :: "('e \<Rightarrow> 'v) \<Rightarrow> ('e \<Rightarrow> 'v) \<Rightarrow> 'e dart \<Rightarrow> 'v" where
  "source s t (Pos e) = s e"
| "source s t (Neg e) = t e"

abbreviation target where "target s t a \<equiv> source t s a"

lemma source_inverse [simp]: "source s t (inverse a) = target s t a"
  by (cases a) simp_all

inductive walk :: "('e \<Rightarrow> 'v) \<Rightarrow> ('e \<Rightarrow> 'v) \<Rightarrow>
    'v \<Rightarrow> 'e dart list \<Rightarrow> 'v \<Rightarrow> bool" for s t where
  nil [intro]: "walk s t x [] x"
| cons [intro]: "walk s t (target s t a) p y \<Longrightarrow>
    walk s t (source s t a) (a # p) y"

lemma walk_Nil [simp]: "walk s t x [] y \<longleftrightarrow> x = y"
  by (auto elim: walk.cases)

lemma walk_Cons [simp]:
  "walk s t x (a # p) y \<longleftrightarrow>
    x = source s t a \<and> walk s t (target s t a) p y"
  by (auto elim: walk.cases)

lemma walk_append [simp]:
  "walk s t x (p @ q) z \<longleftrightarrow>
    (\<exists>y. walk s t x p y \<and> walk s t y q z)"
  by (induct p arbitrary: x) auto

lemma walk_endpoint_unique:
  "walk s t x p y \<Longrightarrow> walk s t x p z \<Longrightarrow> y = z"
  by (induct p arbitrary: x) auto

definition reverse_path :: "'e dart list \<Rightarrow> 'e dart list" where
  "reverse_path p = rev (map inverse p)"

lemma reverse_path_simps [simp]:
  "reverse_path [] = []"
  "reverse_path (a # p) = reverse_path p @ [inverse a]"
  "reverse_path (p @ q) = reverse_path q @ reverse_path p"
  "reverse_path (reverse_path p) = p"
  by (simp_all add: reverse_path_def rev_map comp_def)

lemma walk_reverse:
  "walk s t x p y \<Longrightarrow> walk s t y (reverse_path p) x"
  by (induct rule: walk.induct) auto

section \<open>Inverse cancellation and path equality\<close>

inductive cancel :: "'e dart list \<Rightarrow> 'e dart list \<Rightarrow> bool" where
  pair: "cancel (p @ a # inverse a # q) (p @ q)"

lemma cancel_length:
  "cancel p q \<Longrightarrow> length p = length q + 2"
  by (auto elim: cancel.cases)

lemma cancel_subject_reduction:
  assumes C: "cancel p q" and W: "walk s t x p y"
  shows "walk s t x q y"
proof -
  from C obtain l a r where P: "p = l @ a # inverse a # r" and Q: "q = l @ r"
    by (cases rule: cancel.cases) auto
  from W show ?thesis by (auto simp: P Q)
qed

lemma cancellation_terminates:
  "wf {(q,p). cancel p q}"
  by (rule wf_subset[OF wf_measure[of length]])
    (auto dest: cancel_length)

text \<open>Equality is generated by typed cancellations. Expansions are required
  to have the same endpoints; ill-formed inserted paths are never admitted.\<close>

inductive path_equal :: "('e \<Rightarrow> 'v) \<Rightarrow> ('e \<Rightarrow> 'v) \<Rightarrow>
    'v \<Rightarrow> 'e dart list \<Rightarrow> 'e dart list \<Rightarrow> 'v \<Rightarrow> bool" for s t where
  refl: "walk s t x p y \<Longrightarrow> path_equal s t x p p y"
| cancel: "walk s t x p y \<Longrightarrow> cancel p q \<Longrightarrow> path_equal s t x p q y"
| sym: "path_equal s t x p q y \<Longrightarrow> path_equal s t x q p y"
| trans: "path_equal s t x p q y \<Longrightarrow> path_equal s t x q r y \<Longrightarrow>
    path_equal s t x p r y"

lemma path_equal_typed:
  "path_equal s t x p q y \<Longrightarrow> walk s t x p y \<and> walk s t x q y"
  by (induct rule: path_equal.induct) (auto dest: cancel_subject_reduction)

lemma cancel_context:
  "cancel p q \<Longrightarrow> cancel (l @ p @ r) (l @ q @ r)"
proof (induct rule: cancel.induct)
  case (pair p a q)
  from cancel.pair[of "l @ p" a "q @ r"] show ?case
    by (simp add: append_assoc)
qed

lemma path_equal_context:
  assumes "path_equal s t x p q y" "walk s t w l x" "walk s t y r z"
  shows "path_equal s t w (l @ p @ r) (l @ q @ r) z"
  using assms
  by (induct rule: path_equal.induct)
    (meson walk_append path_equal.intros cancel_context)+

lemma path_equal_inverse_right:
  assumes W: "walk s t x p y"
  shows "path_equal s t x (p @ reverse_path p) [] x"
  using W
proof (induct rule: walk.induct)
  case (nil x)
  then show ?case by (simp add: path_equal.refl)
next
  case (cons a p y)
  have L: "walk s t (source s t a) [a] (target s t a)" by simp
  have R: "walk s t (target s t a) [inverse a] (source s t a)" by simp
  have E: "path_equal s t (source s t a)
      ([a] @ (p @ reverse_path p) @ [inverse a])
      ([a] @ [] @ [inverse a]) (source s t a)"
    by (rule path_equal_context[OF cons(2) L R])
  have C: "cancel [a, inverse a] []"
    using cancel.pair[of "[]" a "[]"] by simp
  have W2: "walk s t (source s t a) [a, inverse a] (source s t a)" by simp
  have "path_equal s t (source s t a) [a, inverse a] [] (source s t a)"
    by (rule path_equal.cancel[OF W2 C])
  from path_equal.trans[OF E[simplified] this]
  show ?case by (simp add: append_assoc)
qed

lemma path_equal_inverse_left:
  "walk s t x p y \<Longrightarrow> path_equal s t y (reverse_path p @ p) [] y"
  using path_equal_inverse_right[OF walk_reverse] by simp

end
